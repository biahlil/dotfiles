{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        {
            "type": "datetime",
            "format": "{11}/{3}/{1} {14}:{17}:{20}" // dd/mm/yyyy hh:mm:ss
        },
        "de",
        "wm",
        "font",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "poweradapter",
        "break",
        "colors"
    ]
}